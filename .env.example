# Copia questo file in .env e adatta i valori.

# Porta HTTP del server (i PaaS la impostano da soli).
PORT=3000

# Connessione a PostgreSQL.
# In locale con `npm run db:local` o con docker compose:
DATABASE_URL=postgres://pokeportfolio:pokeportfolio@localhost:5432/pokeportfolio
# Sui servizi gestiti (Neon, Supabase, Render...) serve di solito SSL:
# DATABASE_SSL=true

# Fuso orario usato per i job notturni e per le date mostrate nell'app.
TZ=Europe/Rome

# API key CardTrader usata per la sync del catalogo e per gli utenti
# che non hanno una key personale.
CARDTRADER_DEFAULT_TOKEN=

# Job notturni (prezzi alle 03:00, nuovi set alle 05:00).
# Sui PaaS che addormentano l'app: SCHEDULER=false e un cron esterno che
# chiama POST /api/cron/prices e /api/cron/catalog-sync con l'header
# "Authorization: Bearer <CRON_SECRET>".
SCHEDULER=true
CRON_SECRET=

{
  "name": "pokeportfolio",
  "version": "2.0.0",
  "description": "Collezione di carte Pokémon con prezzi da CardTrader — server Node + PostgreSQL",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/src/index.js",
    "migrate": "node --env-file-if-exists=.env server/src/db/migrate.js",
    "db:local": "node --env-file-if-exists=.env server/scripts/db-local.js",
    "test": "node --env-file-if-exists=.env --test 'server/test/**/*.test.js'"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
